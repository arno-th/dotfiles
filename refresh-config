#!/usr/bin/env bash
# Define array of folders to copy
folders=(
    "ghostty"
    "gtk-3.0"
    "i3"
    "nitrogen"
    "ohmyposh"
    "polybar"
    "rofi"
    "scripts"
    "nvim"
)

# Define the source directory
source_dir="$HOME/.config"

# Define the destination directory (current)
destination_dir="$(pwd)/env/.config"

# Copy each folder from source to destination
for folder in "${folders[@]}"; do
    cp -r "$source_dir/$folder" "$destination_dir/"
done

# Refresh Omarchy global workspaces (see runs/omarchy-workspaces)
mkdir -p "$destination_dir/hypr" "$destination_dir/omarchy/plugins"
cp "$source_dir/hypr/global-workspaces.lua" "$destination_dir/hypr/"
cp -r "$source_dir/omarchy/plugins/arnot.workspaces" "$destination_dir/omarchy/plugins/"

# Refresh zsh config
cp "$HOME/.zshrc" "$(pwd)/env/.zshrc"

# Refresh tmux config
cp "$HOME/.tmux.conf" "$(pwd)/env/.tmux.conf"
